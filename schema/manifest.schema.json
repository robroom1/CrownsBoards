{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://raw.githubusercontent.com/robroom1/CrownsBoards/main/schema/manifest.schema.json","title":"Crowns remote board manifest","type":"object","additionalProperties":false,"required":["schemaVersion","contentVersion","packs"],"properties":{"schemaVersion":{"const":1},"contentVersion":{"type":"integer","minimum":1},"packs":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","file","version","sha256","boardCount"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,63}$"},"file":{"type":"string","pattern":"^packs/[A-Za-z0-9._-]+\\.crowns$"},"version":{"type":"integer","minimum":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"boardCount":{"type":"integer","minimum":1,"maximum":100}}}}}}
